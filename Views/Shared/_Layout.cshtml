<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Elective 2 Prefinal Exam</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">&lt;/&gt;</span> Prefinal Exam Review
            </a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Exam" asp-action="Index">Questions</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>Sophia Cassandra Solis &middot; Section 31E1 &middot; IT Elective 2 &ndash; Web Systems and Technologies &middot; Prefinal Exam</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
